<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical"
    tools:context=".ui.start.StartActivity">

    <com.linx.mylibrary.view.loadingStateView.MultipleStatusView
        android:id="@+id/nn"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_40"
            android:orientation="vertical">


            <TextView
                android:id="@+id/tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="启动页面"
                tools:ignore="MissingConstraints" />

            <Button
                android:id="@+id/bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="启动页面"
                tools:ignore="MissingConstraints" />

            <Button
                android:id="@+id/bt_h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="变黑"
                tools:ignore="MissingConstraints" />

            <Button
                android:id="@+id/bt_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="变白"
                tools:ignore="MissingConstraints" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="变白"
                android:textColor="@color/text_primary"
                tools:ignore="MissingConstraints" />

            <com.linx.mylibrary.view.editText.ClearEditText
                style="@style/EditTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_10"
                android:text="这是一个带清除的按钮的EditText" />

            <com.linx.mylibrary.view.editText.PasswordEditText
                style="@style/EditTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_10"
                android:maxLength="20"
                android:singleLine="true"
                android:text="78797078" />

            <com.linx.mylibrary.view.editText.RegexEditText
                style="@style/EditTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_40"
                android:hint="这里只能输入手机号（只能以 1 开头）"
                app:regexType="mobile" />

            <com.linx.mylibrary.view.SimpleRatingBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:grade="2.5"
                app:gradeStep="half" />

            <com.linx.mylibrary.view.SimpleRatingBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:grade="3"
                app:gradeStep="one" />

        </LinearLayout>
    </com.linx.mylibrary.view.loadingStateView.MultipleStatusView>


</ScrollView>