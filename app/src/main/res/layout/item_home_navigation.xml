<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="@dimen/sw_7dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_home_navigation_icon"
        android:layout_width="@dimen/sw_22dp"
        android:scaleType="fitXY"
        android:src="@mipmap/ic_launcher"
        android:layout_height="@dimen/sw_23dp" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/tv_home_navigation_title"
        android:layout_width="wrap_content"
        android:text="首页"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_2dp"
        android:textSize="@dimen/sw_12sp"
        app:shape_textColor="@color/text_primary"
        app:shape_textSelectedColor="@color/colorPrimaryDark" />

</LinearLayout>