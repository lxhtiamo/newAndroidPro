<?xml version="1.0" encoding="utf-8"?>
<!-- 直角按钮样式 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 禁用状态 -->
    <item android:drawable="@color/bg_button_disabled" android:state_enabled="false" />

    <!-- 按压状态 -->
    <item android:drawable="@color/primary_800" android:state_pressed="true" />

    <!-- 焦点状态 -->
    <item android:drawable="@color/primary_800" android:state_focused="true" />

    <!-- 默认状态 -->
    <item android:drawable="@color/bg_button" />

</selector>