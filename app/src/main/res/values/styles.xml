<resources>
    <!-- ===================== 核心主题配置 ===================== -->
    <!-- 应用基础主题：基于Material3日夜模式（无ActionBar），兼容AppCompat核心属性 -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 窗口背景色（当前注释，可根据需求启用） -->
        <!--  <item name="android:windowBackground">@color/windowBackground</item>-->

        <!-- ========== AppCompat 经典配色（向下兼容） ========== -->
        <!-- 应用主色调：ActionBar/Toolbar底色（AppCompat核心属性） -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!-- 主色调暗版：状态栏默认底色（AppCompat核心属性） -->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <!-- 应用强调色：复选框/单选框/开关等选中态（AppCompat核心属性） -->
        <item name="colorAccent">@color/colorAccent</item>

        <!-- ========== Material3 核心配色（替代/补充AppCompat） ========== -->
        <!-- Material3强调色：替代colorAccent避免映射冲突（M3核心属性） -->
        <item name="colorSecondary">@color/colorAccent</item>
        <!-- Material3二级色调容器色：二级元素背景（M3规范） -->
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <!-- Material3二级色调文字色：二级元素文本（M3规范） -->
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <!-- Material3主色调容器色：主元素背景（M3规范） -->
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <!-- Material3主色调文字色：主元素文本（M3规范） -->
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <!-- Material3背景色：页面整体背景（M3规范） -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <!-- Material3背景文字色：背景上的文本（M3规范） -->
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <!-- Material3表面色：控件/卡片背景（M3规范） -->
        <item name="colorSurface">@color/colorSurface</item>
        <!-- Material3表面文字色：控件/卡片文本（M3规范） -->
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <!-- Material3错误色：输入错误/提示（M3规范） -->
        <item name="colorError">@color/colorError</item>
        <!-- Material3错误文字色：错误提示文本（M3规范） -->
        <item name="colorOnError">@color/colorOnError</item>

        <!-- ========== 窗口/布局行为配置 ========== -->
        <!-- ActionMode覆盖ActionBar（不向下挤压） -->
        <item name="windowActionModeOverlay">true</item>
        <!-- 移除窗口内容阴影（避免冗余绘制） -->
        <item name="android:windowContentOverlay">@null</item>
        <!-- ImageView自动等比拉伸图片（解决缩放变形） -->
        <item name="android:adjustViewBounds">true</item>
        <!-- ActionMode背景色：与主色调一致 -->
        <item name="actionModeBackground">@color/colorPrimary</item>

        <!-- ========== 文本样式配置 ========== -->
        <!-- 禁用Button英文字符自动大写（Android 5.1+） -->
        <item name="android:textAllCaps">false</item>
        <!-- 关闭TextView默认字体内边距（精准控制文本排版） -->
        <item name="android:includeFontPadding">false</item>
        <!-- Material3主文本色：标题/正文等核心文本 -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <!-- 默认文本色：Button/TextView等通用文本 -->
        <item name="android:textColor">@color/text_primary</item>

        <!-- ========== 控件样式覆盖 ========== -->
        <!-- 全局AppCompat Button样式：自定义内边距 -->
        <item name="android:buttonStyle">@style/AppCompat_Button_Default_Padding</item>
        <!-- 全局Material3 Button样式：自定义内边距 -->
        <item name="materialButtonStyle">@style/MD_Button_Default_Padding</item>

        <!-- ========== 无ActionBar配置 ========== -->
        <!-- 禁用系统ActionBar（解决Dialog全屏问题） -->
        <item name="android:windowActionBar">false</item>
        <!-- 隐藏标题栏 -->
        <item name="windowNoTitle">true</item>

        <!-- ========== EdgeToEdge 沉浸式配置 ========== -->
        <!-- 状态栏透明：背景延伸至状态栏 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- 导航栏透明：背景延伸至导航栏 -->
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- ========== 页面切换动画 ========== -->
        <!-- Activity跳转动画：从左到右滑入 -->
        <item name="android:windowAnimationStyle">@style/LeftToRightAnimStyle</item>
    </style>

    <!-- ===================== 启动页主题（旧版兼容） ===================== -->
    <!-- 启动页主题：解决启动白屏，基于AppCompat浅色无ActionBar -->
    <style name="LauncherTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- 核心：启动页背景（建议用webp/9图避免拉伸，当前注释） -->
        <!--<item name="android:windowBackground">@drawable/start_bg</item>-->

        <!-- 全屏显示：隐藏状态栏 -->
        <item name="android:windowFullscreen">true</item>
        <!-- 禁用窗口动画：加快启动速度 -->
        <item name="android:windowAnimationStyle">@null</item>
        <!-- 固定竖屏：减少屏幕旋转的配置切换耗时 -->
        <item name="android:screenOrientation">portrait</item>
        <!-- 导航栏半透明（Android 8+）：视觉全屏效果 -->
        <item name="android:windowTranslucentNavigation">true</item>
        <!-- 移除窗口阴影：减少绘制耗时 -->
        <item name="android:windowContentOverlay">@null</item>

        <!-- ========== AppCompat 启动页配色补充 ========== -->
        <!-- 启动页主色调（兼容AppCompat） -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!-- 启动页强调色（兼容AppCompat） -->
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- ===================== Android 12+ 闪屏主题 ===================== -->
    <!-- 闪屏主题：基于系统SplashScreen API（Android 12+） -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- 闪屏背景色：黄色（可替换为品牌色） -->
        <item name="windowSplashScreenBackground">@color/yellow</item>
        <!-- 闪屏动画图标（必须是矢量图，当前注释） -->
        <!-- <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>-->
        <!-- 闪屏图标背景色（可选，提升对比度，当前注释） -->
        <!--  <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>-->
        <!-- 底部品牌图（可选，尺寸200x80dp，当前注释） -->
        <!--  <item name="windowSplashScreenBrandingImage">@drawable/splash_branding</item>-->
        <!-- 闪屏动画时长（可选，系统自动推断，当前注释） -->
        <!-- <item name="windowSplashScreenAnimationDuration">1000</item>-->
        <!-- 闪屏结束后跳转的主题：指向LauncherTheme -->
        <item name="postSplashScreenTheme">@style/LauncherTheme</item>
    </style>

    <!-- ===================== 全屏主题（基于AppTheme） ===================== -->
    <!-- 全屏主题：继承AppTheme并强制全屏（隐藏状态栏） -->
    <style name="FullScreenTheme" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- ===================== 控件样式 ===================== -->
    <!-- ImageView圆角样式：通用圆角配置 -->
    <style name="ImageView_roundedCorner">
        <item name="cornerFamily">rounded</item> <!-- 圆角类型：普通圆角 -->
        <item name="cornerSize">@dimen/sw_12dp</item> <!-- 圆角尺寸：12dp（适配不同屏幕） -->
    </style>

    <!-- Material3 Button样式：移除默认上下内边距 -->
    <style name="MD_Button_Default_Padding" parent="Widget.Material3.Button">
        <item name="android:insetTop">@dimen/sw_0dp</item> <!-- 顶部内边距：0dp -->
        <item name="android:insetBottom">@dimen/sw_0dp</item> <!-- 底部内边距：0dp -->
        <item name="android:insetLeft">@dimen/sw_0dp</item>
        <item name="android:insetRight">@dimen/sw_0dp</item>
        <!-- ========== Material3 Button 配色补充 ========== -->
        <item name="backgroundTint">@color/colorPrimary</item> <!-- M3按钮背景色 -->
        <item name="android:textColor">@color/colorOnPrimary</item> <!-- M3按钮文本色 -->
        <item name="android:textSize">@dimen/sw_14sp</item>
        <!-- 继承通用按钮的padding/min尺寸（和AppCompatButton保持一致） -->
        <item name="android:paddingStart">@dimen/sw_20dp</item>
        <item name="android:paddingEnd">@dimen/sw_20dp</item>
        <item name="android:paddingTop">@dimen/sw_12dp</item>
        <item name="android:paddingBottom">@dimen/sw_12dp</item>
        <item name="android:minWidth">@dimen/sw_0dp</item>
        <item name="android:minHeight">@dimen/sw_0dp</item>
        <item name="android:foreground">@null</item>
    </style>

    <!-- AppCompat Button样式：移除默认上下内边距 + 配色修正 -->
    <style name="AppCompat_Button_Default_Padding" parent="Widget.AppCompat.Button">
        <item name="android:insetTop">@dimen/sw_0dp</item> <!-- 顶部内边距：0dp -->
        <item name="android:insetBottom">@dimen/sw_0dp</item> <!-- 底部内边距：0dp -->
        <item name="android:insetLeft">@dimen/sw_0dp</item>
        <item name="android:insetRight">@dimen/sw_0dp</item>
        <!-- 显式指定文本色：覆盖colorAccent的错误映射（AppCompat） -->
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:textSize">@dimen/sw_14sp</item>
        <!-- AppCompat按钮背景色：避免继承Material3颜色冲突 -->
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/button_circle_selector</item>
        <!-- 统一内边距（核心） -->
        <item name="android:paddingStart">@dimen/sw_20dp</item>
        <item name="android:paddingEnd">@dimen/sw_20dp</item>
        <item name="android:paddingTop">@dimen/sw_12dp</item>
        <item name="android:paddingBottom">@dimen/sw_12dp</item>
        <!-- 统一最小尺寸：取消系统默认88dp/36dp限制（关键） -->
        <item name="android:minWidth">@dimen/sw_0dp</item>
        <item name="android:minHeight">@dimen/sw_0dp</item>
        <item name="android:foreground">@null</item>
    </style>

    <!--==================================通用组件样式=========================================-->
    <!-- 默认按钮样式 -->
    <style name="CommonButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:paddingStart">@dimen/sw_20dp</item>
        <item name="android:paddingEnd">@dimen/sw_20dp</item>
        <item name="android:paddingTop">@dimen/sw_12dp</item>
        <item name="android:paddingBottom">@dimen/sw_12dp</item>
        <item name="android:textSize">@dimen/sw_14sp</item>
        <item name="android:textColor">@color/white90</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/button_circle_selector</item>
        <item name="android:minWidth">@dimen/sw_0dp</item>
        <item name="android:minHeight">@dimen/sw_0dp</item>
        <item name="android:foreground">@null</item>
        <!-- 禁用英文自动大写（统一体验） -->
        <item name="android:textAllCaps">false</item>
        <!-- 取消字体内边距（精准控制排版） -->
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>