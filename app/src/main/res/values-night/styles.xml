<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 窗口背景色（当前注释，可根据需求启用） -->
        <!--  <item name="android:windowBackground">@color/windowBackground</item>-->

        <!-- ========== AppCompat 经典配色（向下兼容） ========== -->
        <!-- 应用主色调：ActionBar/Toolbar底色（AppCompat核心属性） -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!-- 主色调暗版：状态栏默认底色（AppCompat核心属性） -->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <!-- 应用强调色：复选框/单选框/开关等选中态（AppCompat核心属性） -->
        <item name="colorAccent">@color/colorAccent</item>

        <!-- ========== Material3 核心配色（替代/补充AppCompat） ========== -->
        <!-- Material3强调色：替代colorAccent避免映射冲突（M3核心属性） -->
        <item name="colorSecondary">@color/colorAccent</item>
        <!-- Material3二级色调容器色：二级元素背景（M3规范） -->
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <!-- Material3二级色调文字色：二级元素文本（M3规范） -->
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <!-- Material3主色调容器色：主元素背景（M3规范） -->
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <!-- Material3主色调文字色：主元素文本（M3规范） -->
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <!-- Material3背景色：页面整体背景（M3规范） -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <!-- Material3背景文字色：背景上的文本（M3规范） -->
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <!-- Material3表面色：控件/卡片背景（M3规范） -->
        <item name="colorSurface">@color/colorSurface</item>
        <!-- Material3表面文字色：控件/卡片文本（M3规范） -->
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <!-- Material3错误色：输入错误/提示（M3规范） -->
        <item name="colorError">@color/colorError</item>
        <!-- Material3错误文字色：错误提示文本（M3规范） -->
        <item name="colorOnError">@color/colorOnError</item>

        <!-- ========== 窗口/布局行为配置 ========== -->
        <!-- ActionMode覆盖ActionBar（不向下挤压） -->
        <item name="windowActionModeOverlay">true</item>
        <!-- 移除窗口内容阴影（避免冗余绘制） -->
        <item name="android:windowContentOverlay">@null</item>
        <!-- ImageView自动等比拉伸图片（解决缩放变形） -->
        <item name="android:adjustViewBounds">true</item>
        <!-- ActionMode背景色：与主色调一致 -->
        <item name="actionModeBackground">@color/colorPrimary</item>

        <!-- ========== 文本样式配置 ========== -->
        <!-- 禁用Button英文字符自动大写（Android 5.1+） -->
        <item name="android:textAllCaps">false</item>
        <!-- 关闭TextView默认字体内边距（精准控制文本排版） -->
        <item name="android:includeFontPadding">false</item>
        <!-- Material3主文本色：标题/正文等核心文本 -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <!-- 默认文本色：Button/TextView等通用文本 -->
        <item name="android:textColor">@color/text_primary</item>

        <!-- ========== 控件样式覆盖 ========== -->
        <!-- 全局AppCompat Button样式：自定义内边距 -->
        <item name="android:buttonStyle">@style/AppCompat_Button_Default_Padding</item>
        <!-- 全局Material3 Button样式：自定义内边距 -->
        <item name="materialButtonStyle">@style/MD_Button_Default_Padding</item>

        <!-- ========== 无ActionBar配置 ========== -->
        <!-- 禁用系统ActionBar（解决Dialog全屏问题） -->
        <item name="android:windowActionBar">false</item>
        <!-- 隐藏标题栏 -->
        <item name="windowNoTitle">true</item>

        <!-- ========== EdgeToEdge 沉浸式配置 ========== -->
        <!-- 状态栏透明：背景延伸至状态栏 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- 导航栏透明：背景延伸至导航栏 -->
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- ========== 页面切换动画 ========== -->
        <!-- Activity跳转动画：从左到右滑入 -->
        <item name="android:windowAnimationStyle">@style/LeftToRightAnimStyle</item>
    </style>
</resources>
