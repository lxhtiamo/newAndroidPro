<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <declare-styleable name="RxScaleImageView">
        <attr name="src" format="reference" />
        <attr name="assetName" format="string" />
        <attr name="panEnabled" format="boolean" />
        <attr name="zoomEnabled" format="boolean" />
        <attr name="quickScaleEnabled" format="boolean" />
        <attr name="tileBackgroundColor" format="color" />
    </declare-styleable>


    <!-- 正则表达式编辑框 -->
    <declare-styleable name="RegexEditText">
        <!-- 正则输入限制 -->
        <attr name="inputRegex" format="string" />
        <!-- 常用正则类型 -->
        <attr name="regexType" >
            <!-- 手机号（只能以 1 开头）-->
            <enum name="mobile" value="0x01" />
            <!-- 中文（普通的中文字符）-->
            <enum name="chinese" value="0x02" />
            <!-- 英文（大写和小写的英文）-->
            <enum name="english" value="0x03" />
            <!-- 数字（只允许输入纯数字）-->
            <enum name="number" value="0x04" />
            <!-- 整数（非 0 开头的数字）-->
            <enum name="count" value="0x05" />
            <!-- 用户名（中文、英文、数字）-->
            <enum name="name" value="0x06" />
            <!-- 非空格字符 -->
            <enum name="nonnull" value="0x07" />
        </attr>
    </declare-styleable>

    <declare-styleable name="ClearEditText">
        <attr name="clearIcon" format="reference" />
        <attr name="clearIconTint" format="color" />
    </declare-styleable>

    <declare-styleable name="PasswordEditText">
        <attr name="passwordVisibleIcon" format="reference" /> <!-- 密码可见时的图标 -->
        <attr name="passwordInvisibleIcon" format="reference" /> <!-- 密码不可见时的图标 -->
        <attr name="passwordIconTint" format="color" /> <!-- 图标着色 -->
    </declare-styleable>


    <!-- 自定义评分控件 -->
    <declare-styleable name="SimpleRatingBar">
        <!-- 当前星等级 -->
        <attr name="grade" format="float"/>
        <!-- 星星总数量 -->
        <attr name="gradeCount" format="integer"/>
        <!-- 星星的宽度 -->
        <attr name="gradeWidth" format="dimension" />
        <!-- 星星的高度 -->
        <attr name="gradeHeight" format="dimension" />
        <!-- 星星之间的间隔 -->
        <attr name="gradeSpace" format="dimension"/>
        <!-- 星星选择跨度 -->
        <attr name="gradeStep" format="enum" >
            <!-- 半颗星 -->
            <enum name="half" value="0x00" />
            <!-- 一颗星 -->
            <enum name="one" value="0x01" />
        </attr>
        <!-- 默认的星星图标 -->
        <attr name="normalDrawable" format="reference"/>
        <!-- 半颗的星星图标 -->
        <attr name="halfDrawable" format="reference"/>
        <!-- 选中的星星图标 -->
        <attr name="fillDrawable" format="reference"/>
        <!-- 是否支持触摸交互：设置控件是否可通过触摸进行评分操作 -->
        <attr name="touchable" format="boolean" />
        <!-- 是否启用评分动画：控制评分变化时是否展示过渡动画效果 -->
        <attr name="animationEnabled" format="boolean" />
        <!-- 动画持续时长：设置评分动画的执行时间（单位：毫秒） -->
        <attr name="animationDuration" format="integer" />
        <!-- 点击是否重置评分：设置点击已选中的评分项时，是否将评分重置为0 -->
        <attr name="clickToReset" format="boolean" />
        <!-- 最低评分限制：设置允许的最低评分值（支持小数） -->
        <attr name="minimumGrade" format="float" />
        <!-- 是否自动适配尺寸：控制评分控件是否根据内容自动调整大小 -->
        <attr name="autoSize" format="boolean" />
        <!-- 自动适配的最大宽度：设置控件自动适配时的最大宽度限制（支持dp/px等维度单位） -->
        <attr name="maxAutoSizeWidth" format="dimension" />
        <!-- 是否启用按压效果：设置控件被点击/按压时是否展示视觉反馈效果 -->
        <attr name="enablePressedEffect" format="boolean" />
        <!-- 是否允许零分：控制评分是否可以设置为0分（关闭时最低为minimumGrade或1分） -->
        <attr name="allowZeroRating" format="boolean" />

    </declare-styleable>
</resources>